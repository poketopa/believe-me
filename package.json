{
  "name": "@poketopa/believe-me",
  "version": "0.2.0",
  "private": false,
  "description": "BelieveMe is an evidence-first execution harness for safe, verifiable AI code changes",
  "type": "module",
  "bin": {
    "believeme": "bin/believeme.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "benchmark:smoke:codex": "node scripts/live-benchmark-smoke.js",
    "smoke:codex": "node scripts/live-codex-smoke.js",
    "release:check": "node scripts/check-release.js",
    "test": "node scripts/run-node-tests.js",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poketopa/believe-me.git"
  },
  "homepage": "https://github.com/poketopa/believe-me#readme",
  "bugs": {
    "url": "https://github.com/poketopa/believe-me/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ai-agent",
    "developer-tools",
    "evidence",
    "harness",
    "verification"
  ]
}
